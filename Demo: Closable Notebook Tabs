# Styles Setup ----------------------------------------------------------------
def setup_workspace_styles() -> ttk.Style:
    """
    Registers custom close-state images and builds the CustomNotebook style layout.
    """
    style = ttk.Style()
    style.theme_use("clam")
    style.configure("Treeview", rowheight=CONFIG["ROW_HEIGHT"], font=CONFIG["FONT_BODY"])
    
    # Hide native notebook tabs completely
    style.layout("Tabless.TNotebook.Tab", None)
    style.configure("Tabless.TNotebook", tabmargins=0, borderwidth=0, highlightthickness=0)
    return style

