"""
Demo: Scrollable Notebook Tabs
Created: August 26, 2026

Description: Solves tab overflow problem in the "Demo: Closable Notebook Tabs" 
project by pairing a tabless ttk.Notebook with a canvas-backed scrollable tab 
bar. Features mousewheel scrolling, left/right scroll buttons, active-tab 
auto-scrolling, and sidebar bidirectional sync.

Based on "Demo: Closable Notebook Tabs" project.
"""

import tkinter as tk
from tkinter import ttk


# Centralized Configuration ---------------------------------------------------
CONFIG = {
    "WINDOW_TITLE": "Demo: Dynamic Workspace Manager (Scrollable Tabs)",
    "WINDOW_GEOMETRY": "1000x560",
    "FONT_HEADER": ("Segoe UI", 11, "bold"),
    "FONT_BODY": ("Segoe UI", 10),
    "FONT_TAB": ("Segoe UI", 9),
    "FONT_CLOSE": ("Segoe UI", 8, "bold"),
    "ROW_HEIGHT": 28,
    "COLOR_STRIP_BG": "#EFEFEF",
    "COLOR_BORDER": "#BCBCBC",
    "COLOR_TAB_INACTIVE": "#E4E4E4",
    "COLOR_WORKSPACE_BG": "#FFFFFF",
}


# Tab Content Registry --------------------------------------------------------
TAB_REGISTRY = {
    "dev_dash": {"title": "Analytics Dashboard", "header": "Development Analytics Overview"},
    "dev_shell": {"title": "Shell Terminal Console", "header": "Developer Sandbox Environment Shell"},
    "dev_git": {"title": "Source Version Control", "header": "Git Repository Branches & Commit History"},
    "dev_api": {"title": "API Gateway Inspector", "header": "REST & GraphQL Endpoint Traffic Monitor"},
    "adm_rules": {"title": "Global System Rules", "header": "Cluster Operations & Security Configurations"},
    "adm_vault": {"title": "Database Key Vault", "header": "Encrypted Asset Credentials Storage"},
    "adm_logs": {"title": "Live Server Logs", "header": "Real-Time System Log Streams & Trace Audits"},
    "adm_perf": {"title": "Performance Monitor", "header": "CPU, RAM & Network Resource Diagnostics"},
}


# Styles Setup ----------------------------------------------------------------
def setup_workspace_styles() -> ttk.Style:
    """Configures the theme and completely suppresses native notebook tabs."""
    style = ttk.Style()
    style.theme_use("clam")
    style.configure("Treeview", rowheight=CONFIG["ROW_HEIGHT"], font=CONFIG["FONT_BODY"])

    # 1. Redefine the notebook layout so it ONLY draws the client viewport
    # This strips out the tab row entirely.
    style.layout("Tabless.TNotebook", [
        ("Tabless.TNotebook.client", {"sticky": "nswe"})
    ])

    # 2. Empty out the Tab element layout explicitly
    style.layout("Tabless.TNotebook.Tab", [])

    # 3. Collapse tab dimensions and padding to 0
    style.configure(
        "Tabless.TNotebook", 
        tabmargins=0, 
        borderwidth=0, 
        highlightthickness=0
    )
    style.configure(
        "Tabless.TNotebook.Tab", 
        padding=0, 
        borderwidth=0, 
        height=0
    )

    return style


# Sidebar Functions -----------------------------------------------------------
def on_sidebar_click(event: tk.Event, tab_bar_state: dict) -> None:
    """
    Handles sidebar node click to open or select a tab.
    """
    treeview = event.widget
    item = treeview.focus()

    if not item:
        return

    vals = treeview.item(item, "values")

    if vals:
        create_workspace_tab(vals[0], tab_bar_state)


def sync_sidebar_selection(treeview_widget: ttk.Treeview, active_key: str) -> None:
    """
    Highlights the corresponding node in the sidebar.
    """
    for parent_id in treeview_widget.get_children():
        for child_id in treeview_widget.get_children(parent_id):
            vals = treeview_widget.item(child_id, "values")
            if vals and vals[0] == active_key:
                if treeview_widget.focus() != child_id:
                    treeview_widget.item(parent_id, open=True)
                    treeview_widget.selection_set(child_id)
                    treeview_widget.focus(child_id)
                return


# Tab Bar Scrolling & Interaction ---------------------------------------------
def on_tab_bar_mousewheel(event: tk.Event, canvas: tk.Canvas) -> None:
    """
    Scrolls the tab bar horizontally using the mouse wheel.
    """
    if event.delta:
        scroll_tab_bar(canvas, -1 if event.delta > 0 else 1)
    elif event.num == 4:
        scroll_tab_bar(canvas, -1)
    elif event.num == 5:
        scroll_tab_bar(canvas, 1)


def scroll_tab_bar(canvas: tk.Canvas, direction: int) -> None:
    """
    Scrolls the canvas horizontally by units.
    """
    canvas.xview_scroll(direction * 2, "units")


def scroll_tab_into_view(canvas: tk.Canvas, tab_item: tk.Frame) -> None:
    """
    Ensures the active tab is visible in the scrollable viewport.
    """
    canvas.update_idletasks()

    tab_x = tab_item.winfo_x()
    tab_w = tab_item.winfo_width()
    canvas_w = canvas.winfo_width()

    scroll_region = canvas.bbox("all")
    if not scroll_region or scroll_region[2] <= canvas_w:
        return

    total_w = scroll_region[2]
    current_left = canvas.xview()[0] * total_w
    current_right = current_left + canvas_w

    if tab_x < current_left:
        canvas.xview_moveto(max(0.0, tab_x / total_w))
    elif (tab_x + tab_w) > current_right:
        canvas.xview_moveto(min(1.0, (tab_x + tab_w - canvas_w + 20) / total_w))


# Tab Functions ---------------------------------------------------------------
def close_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
    Closes and deallocates a tab frame and its tab-strip button.
    """
    notebook = tab_bar_state["notebook"]
    tabs_dict = tab_bar_state["tabs"]

    if node_key not in tabs_dict:
        return

    tab_info = tabs_dict.pop(node_key)
    tab_info["frame"].destroy()

    # Destroy page in notebook
    notebook.forget(tab_info["page"])
    tab_info["page"].destroy()

    # Update canvas scroll boundaries
    tab_bar_state["canvas"].update_idletasks()
    tab_bar_state["canvas"].configure(scrollregion=tab_bar_state["canvas"].bbox("all"))

    # Switch focus to the latest tab if any remain
    if tabs_dict:
        next_key = list(tabs_dict.keys())[-1]
        select_workspace_tab(next_key, tab_bar_state)
    else:
        tab_bar_state["nav_tree"].selection_set()


def create_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
    Creates a new tab in the notebook and a pill button in the tab bar.
    """
    tabs_dict = tab_bar_state["tabs"]
    notebook = tab_bar_state["notebook"]
    scroll_content = tab_bar_state["scroll_content"]
    tab_meta = TAB_REGISTRY.get(node_key)
    
    if not tab_meta:
        return

    # If already open, just bring to front
    if node_key in tabs_dict:
        select_workspace_tab(node_key, tab_bar_state)
        return

    # 1. Create Notebook Page
    page_frame = ttk.Frame(notebook)
    page_frame.node_key = node_key
    ttk.Label(page_frame, text=tab_meta["header"], font=CONFIG["FONT_HEADER"]).pack(anchor="w", padx=25, pady=25)
    ttk.Label(page_frame, text=f"Active Context: [{tab_meta['title']}]", font=CONFIG["FONT_BODY"]).pack(anchor="w", padx=25)
    notebook.add(page_frame)

    # 2. Create Tab Button Frame in Scrollable Strip
    tab_item = tk.Frame(scroll_content, bg=CONFIG["COLOR_TAB_BG"], bd=1, relief="solid")
    tab_item.pack(side="left", padx=2, pady=3)

    lbl_title = tk.Label(
        tab_item, text=tab_meta["title"], font=CONFIG["FONT_TAB"],
        bg=CONFIG["COLOR_TAB_BG"], padx=6, pady=3, cursor="hand2"
    )
    lbl_title.pack(side="left")

    btn_close = tk.Label(
        tab_item, text="✕", font=CONFIG["FONT_CLOSE"],
        fg="#555555", bg=CONFIG["COLOR_TAB_BG"], padx=4, pady=3, cursor="hand2"
    )
    btn_close.pack(side="right")

    # Hover feedback on close button
    btn_close.bind("<Enter>", lambda e, b=btn_close: b.configure(fg="#E81123"))
    btn_close.bind("<Leave>", lambda e, b=btn_close: b.configure(fg="#555555"))

    # Event bindings
    tab_item.bind("<Button-1>", lambda e, k=node_key: select_workspace_tab(k, tab_bar_state))
    lbl_title.bind("<Button-1>", lambda e, k=node_key: select_workspace_tab(k, tab_bar_state))
    btn_close.bind("<Button-1>", lambda e, k=node_key: close_workspace_tab(k, tab_bar_state))

    # Mousewheel forwarding
    for widget in (tab_item, lbl_title, btn_close):
        widget.bind("<MouseWheel>", lambda e: on_tab_bar_mousewheel(e, tab_bar_state["canvas"]))
        widget.bind("<Button-4>", lambda e: on_tab_bar_mousewheel(e, tab_bar_state["canvas"]))
        widget.bind("<Button-5>", lambda e: on_tab_bar_mousewheel(e, tab_bar_state["canvas"]))

    # Save to state registry
    tabs_dict[node_key] = {
        "page": page_frame,
        "frame": tab_item,
        "lbl_title": lbl_title,
        "btn_close": btn_close
    }

    # Update scroll region and activate
    tab_bar_state["canvas"].update_idletasks()
    tab_bar_state["canvas"].configure(scrollregion=tab_bar_state["canvas"].bbox("all"))
    select_workspace_tab(node_key, tab_bar_state)


def select_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
    Selects an open tab in the notebook and highlights its header.
    """
    notebook = tab_bar_state["notebook"]
    tabs_dict = tab_bar_state["tabs"]
    nav_tree = tab_bar_state["nav_tree"]

    if node_key not in tabs_dict:
        return

    # Select notebook page
    tab_info = tabs_dict[node_key]
    notebook.select(tab_info["page"])

    # Update visuals & auto-scroll
    update_tab_bar_visuals(tab_bar_state, node_key)
    scroll_tab_into_view(tab_bar_state["canvas"], tab_info["frame"])

    # Sync Treeview selection
    sync_sidebar_selection(nav_tree, node_key)


def update_tab_bar_visuals(tab_bar_state: dict, active_key: str | None) -> None:
    """
    Updates background colors to reflect the active tab.
    """
    for node_key, item in tab_bar_state["tabs"].items():
        is_active = (node_key == active_key)
        bg = CONFIG["COLOR_TAB_ACTIVE"] if is_active else CONFIG["COLOR_TAB_BG"]

        item["frame"].configure(bg=bg)
        item["lbl_title"].configure(bg=bg)
        item["btn_close"].configure(bg=bg)


# Widget Layout Functions -----------------------------------------------------
def build_sidebar_panel(parent: ttk.PanedWindow) -> tuple[ttk.Frame, ttk.Treeview]:
    """
    Builds the left-side hierarchical navigation Treeview.
    """
    sidebar_frame = ttk.Frame(parent, width=250, relief="flat")
    sidebar_frame.pack_propagate(False)

    ttk.Label(sidebar_frame, text="💻 System Clusters", font=CONFIG["FONT_HEADER"]).pack(anchor="w", padx=10, pady=(10, 5))

    nav_tree = ttk.Treeview(sidebar_frame, show="tree", selectmode="browse")
    nav_tree.pack(fill="both", expand=True, padx=5, pady=5)

    # Tier 1 Root Folders
    cluster_dev = nav_tree.insert("", tk.END, text="📁 Core Development Stack")
    cluster_adm = nav_tree.insert("", tk.END, text="📁 Server Administration Space")

    # Tier 1: Development Stack (4 items)
    nav_tree.insert(cluster_dev, tk.END, text="📊 Analytics Dashboard", values=("dev_dash",))
    nav_tree.insert(cluster_dev, tk.END, text="💻 Shell Terminal Console", values=("dev_shell",))
    nav_tree.insert(cluster_dev, tk.END, text="🌿 Source Version Control", values=("dev_git",))
    nav_tree.insert(cluster_dev, tk.END, text="🌐 API Gateway Inspector", values=("dev_api",))

    # Tier 2: Server Administration Space (4 items)
    nav_tree.insert(cluster_adm, tk.END, text="⚙️ Global System Rules", values=("adm_rules",))
    nav_tree.insert(cluster_adm, tk.END, text="🔒 Database Key Vault", values=("adm_vault",))
    nav_tree.insert(cluster_adm, tk.END, text="📋 Live Server Logs", values=("adm_logs",))
    nav_tree.insert(cluster_adm, tk.END, text="📈 Performance Monitor", values=("adm_perf",))

    nav_tree.item(cluster_dev, open=True)
    nav_tree.item(cluster_adm, open=True)
    return sidebar_frame, nav_tree


def build_workspace(parent: ttk.PanedWindow) -> tuple[ttk.Frame, dict]:
    """
    Builds the right-hand panel containing the scrollable tab strip and notebook.
    """
    workspace_container = ttk.Frame(parent)
    
    # 1. Top Scrollable Tab Header Bar
    tab_strip_frame = tk.Frame(workspace_container, height=36, bg="#D9D9D9")
    tab_strip_frame.pack(side="top", fill="x")
    tab_strip_frame.pack_propagate(False)

    btn_left = tk.Button(
        tab_strip_frame, text="◀", relief="flat", bg="#CCCCCC", width=2,
        command=lambda: scroll_tab_bar(canvas, -1)
    )
    btn_left.pack(side="left", fill="y")

    btn_right = tk.Button(
        tab_strip_frame, text="▶", relief="flat", bg="#CCCCCC", width=2,
        command=lambda: scroll_tab_bar(canvas, 1)
    )
    btn_right.pack(side="right", fill="y")

    canvas = tk.Canvas(tab_strip_frame, height=32, bg="#D9D9D9", highlightthickness=0)
    canvas.pack(side="left", fill="both", expand=True)

    scroll_content = tk.Frame(canvas, bg="#D9D9D9")
    canvas_window = canvas.create_window((0, 0), window=scroll_content, anchor="nw")

    # Keep canvas window height matched
    scroll_content.bind(
        "<Configure>", 
        lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
    )

    # Mousewheel scrolling over the canvas strip
    for w in (canvas, scroll_content, tab_strip_frame):
        w.bind("<MouseWheel>", lambda e: on_tab_bar_mousewheel(e, canvas))
        w.bind("<Button-4>", lambda e: on_tab_bar_mousewheel(e, canvas))
        w.bind("<Button-5>", lambda e: on_tab_bar_mousewheel(e, canvas))

    # 2. Bottom Tabless Notebook Workspace
    notebook = ttk.Notebook(workspace_container, style="Tabless.TNotebook")
    notebook.pack(side="top", fill="both", expand=True)

    tab_bar_state = {
        "canvas": canvas,
        "scroll_content": scroll_content,
        "notebook": notebook,
        "tabs": {},
        "nav_tree": None,
    }

    return workspace_container, tab_bar_state


# Master Interface Coordinator ------------------------------------------------
def create_application() -> None:
    """
    Sets up the window and initializes all workspace components.
    """
    root = tk.Tk()
    root.title(CONFIG["WINDOW_TITLE"])
    root.geometry(CONFIG["WINDOW_GEOMETRY"])

    setup_workspace_styles()

    paned_window = ttk.PanedWindow(root, orient=tk.HORIZONTAL)
    paned_window.pack(fill="both", expand=True, padx=10, pady=10)

    # Build Left & Right Panes
    sidebar_frame, nav_tree = build_sidebar_panel(paned_window)
    workspace_frame, tab_bar_state = build_workspace(paned_window)
    tab_bar_state["nav_tree"] = nav_tree

    paned_window.add(sidebar_frame, weight=0)
    paned_window.add(workspace_frame, weight=1)

    # Bind Sidebar Click Event
    nav_tree.bind("<ButtonRelease-1>", lambda e: on_sidebar_click(e, tab_bar_state))

    # Launch with initial default tab
    create_workspace_tab("dev_dash", tab_bar_state)

    root.mainloop()


if __name__ == "__main__":
    create_application()

