"""
Demo: Closable Notebook Tabs
Created: July 16, 2026

Description: Demonstrates a closable notebook tab behavior using a custom ttk 
style layout. The user can click the 'x' to close the tab, and the underlying 
frame is destroyed to free memory.

Based on "Closable Notebook Tabs (Class)" Project
"""

import tkinter as tk
from tkinter import ttk


# Centralized Interface Configuration -----------------------------------------
CONFIG = {
    "WINDOW_TITLE": "Demo: Dynamic Workspace Manager",
    "WINDOW_GEOMETRY": "950x520",
    "FONT_HEADER": ("Segoe UI", 11, "bold"),
    "FONT_BODY": ("Segoe UI", 10),
    "ROW_HEIGHT": 28
}


# Tab Content Registry Schema -------------------------------------------------
TAB_REGISTRY = {
    "dev_dash": {"title": "Analytics Dashboard", "header": "Development Analytics Overview"},
    "dev_shell": {"title": "Shell Terminal Console", "header": "Developer Sandbox Environment Shell"},
    "adm_rules": {"title": "Global System Rules", "header": "Cluster Operations & Security Configurations"},
    "adm_vault": {"title": "Database Key Vault", "header": "Encrypted Asset Credentials Storage"}
}


# Style & Theme Setup ---------------------------------------------------------
def setup_closable_style() -> tuple[ttk.Style, tuple[tk.PhotoImage, ...]]:
    """Registers custom close-state images and builds the CustomNotebook style layout."""
    style = ttk.Style()

    # Create distinct images for normal, active (hover), and pressed states
    images = (
        tk.PhotoImage("img_close", data="""
            R0lGODlhCAAIAMIBAAAAADs7O4+Pj9nZ2Ts7Ozs7Ozs7Ozs7OyH+EUNyZWF0ZWQg
            d2l0aCBHSU1QACH5BAEKAAQALAAAAAAIAAgAAAMVGDBEA0qNJyGw7AmxmuaZhWEU
            5kEJADs=
        """),
        tk.PhotoImage("img_closeactive", data="""
            R0lGODlhCAAIAMIEAAAAAP/SAP/bNNnZ2cbGxsbGxsbGxsbGxiH5BAEKAAQALAAA
            AAAIAAgAAAMVGDBEA0qNJyGw7AmxmuaZhWEU5kEJADs=
        """),
        tk.PhotoImage("img_closepressed", data="""
            R0lGODlhCAAIAMIEAAAAAOUqKv9mZtnZ2Ts7Ozs7Ozs7Ozs7OyH+EUNyZWF0ZWQg
            d2l0aCBHSU1QACH5BAEKAAQALAAAAAAIAAgAAAMVGDBEA0qNJyGw7AmxmuaZhWEU
            5kEJADs=
        """)
    )

    # Register the 'close' element with state-based image transitions
    style.element_create(
        "close", "image", "img_close",
        ("active", "pressed", "!disabled", "img_closepressed"),
        ("active", "!disabled", "img_closeactive"),
        border=8, sticky=""
    )

    # Configure the Notebook and Tab structural layout
    style.layout("CustomNotebook", [("CustomNotebook.client", {"sticky": "nswe"})])
    style.layout("CustomNotebook.Tab", [
        ("CustomNotebook.tab", {
            "sticky": "nswe",
            "children": [
                ("CustomNotebook.padding", {
                    "side": "top",
                    "sticky": "nswe",
                    "children": [
                        ("CustomNotebook.focus", {
                            "side": "top",
                            "sticky": "nswe",
                            "children": [
                                ("CustomNotebook.label", {"side": "left", "sticky": ""}),
                                ("CustomNotebook.close", {"side": "left", "sticky": ""}),
                            ]
                        })
                    ]
                })
            ]
        })
    ])

    return style, images


# Tab Functions --------------------------------------------------------------
def on_close_press(event: tk.Event) -> str | None:
    """
    Detects when mouse down occurs over the close button.
    """
    notebook = event.widget
    element = notebook.identify(event.x, event.y)

    if "close" in element:
        index = notebook.index(f"@{event.x},{event.y}")
        notebook.state(["pressed"])
        notebook._active_tab = index
        return "break"  # Prevents default tab selection behavior while pressing 'X'


def on_close_release(event: tk.Event) -> None:
    """
    Detects when mouse release occurs over the close button to destroy the tab.
    """
    notebook = event.widget

    if not notebook.instate(["pressed"]):
        return

    element = notebook.identify(event.x, event.y)
    notebook.state(["!pressed"])

    if "close" not in element:
        notebook._active_tab = None
        return

    index = notebook.index(f"@{event.x},{event.y}")

    if getattr(notebook, "_active_tab", None) == index:
        # Retrieve and destroy the underlying frame widget to free memory
        tab_widget_name = notebook.tabs()[index]
        tab_widget = notebook.nametowidget(tab_widget_name)
        
        notebook.forget(index)
        tab_widget.destroy()
        notebook.event_generate("<<NotebookTabClosed>>")

    notebook._active_tab = None


# Core Navigation Logic --------------------------------------
def on_sidebar_select(event: tk.Event, notebook: ttk.Notebook) -> None:
    """
    Spawns a new tab panel or shifts focus to an existing one upon node click.
    """
    treeview_widget = event.widget
    selected_item = treeview_widget.focus()
    
    if not selected_item:
        return
        
    item_values = treeview_widget.item(selected_item, "values")
    if not item_values:
        return  # Clicked a cluster folder header
        
    node_key = item_values[0]
    tab_data = TAB_REGISTRY.get(node_key)
    if not tab_data:
        return

    # Check if this tab frame is already open in the notebook
    for index in range(notebook.index("end")):
        tab_frame = notebook.nametowidget(notebook.tabs()[index])
        if getattr(tab_frame, "node_key", None) == node_key:
            notebook.select(index)
            return

    # Dynamic Spawn: Tab was not open, create it
    new_tab_frame = ttk.Frame(notebook)
    new_tab_frame.node_key = node_key  

    ttk.Label(new_tab_frame, text=tab_data["header"], font=CONFIG["FONT_HEADER"]).pack(anchor="w", padx=25, pady=25)
    ttk.Label(new_tab_frame, text=f"Active Environment Context: [{tab_data['title']}]", font=CONFIG["FONT_BODY"]).pack(anchor="w", padx=25)
    
    # Add tab cleanly without manual text-padding hacks
    notebook.add(new_tab_frame, text=f"{tab_data['title']} ")
    notebook.select(new_tab_frame)


def on_notebook_tab_change(event: tk.Event, treeview_widget: ttk.Treeview) -> None:
    """
    Backward Sync: Highlights the matching sidebar row when a tab is focused.
    """
    notebook = event.widget
    if notebook.index("end") == 0:
        return

    try:
        current_frame = notebook.nametowidget(notebook.select())
        active_key = getattr(current_frame, "node_key", None)
    except (tk.TclError, KeyError):
        return

    # Highlight the leaf node sharing the active signature key
    for parent_id in treeview_widget.get_children():
        for child_id in treeview_widget.get_children(parent_id):
            vals = treeview_widget.item(child_id, "values")
            if vals and vals[0] == active_key:
                if treeview_widget.focus() != child_id:
                    treeview_widget.item(parent_id, open=True)
                    treeview_widget.selection_set(child_id)
                    treeview_widget.focus(child_id)
                return


# Create Widgets --------------------------------------------------------------
def create_closable_notebook(parent: tk.Misc, **kwargs) -> ttk.Notebook:
    """
    Factory helper to construct a configured CustomNotebook instance.
    """
    notebook = ttk.Notebook(parent, style="CustomNotebook", **kwargs)
    notebook._active_tab = None

    notebook.bind("<ButtonPress-1>", on_close_press, True)
    notebook.bind("<ButtonRelease-1>", on_close_release)

    return notebook


# Create User Interface -------------------------------------------------------
def create_application() -> None:
    """
    Sets up the Tkinter window and seeds sample tabs.
    """
    root = tk.Tk()
    root.title("Closable Tabs (Functional)")
    root.geometry("400x300")

    # Initialize custom style definitions and retain images reference
    _, tab_images = setup_closable_style()

    # Build the notebook
    notebook = create_closable_notebook(root)
    notebook.pack(side="top", fill="both", expand=True)

    # Attach images reference to widget to prevent garbage collection
    notebook._tab_images = tab_images

    for color in ("red", "orange", "green", "blue", "violet"):
        frame = tk.Frame(notebook, background=color)
        notebook.add(frame, text=color)

    root.mainloop()

# Main Application Entry ------------------------------------------------------
if __name__ == "__main__":
    create_application()

