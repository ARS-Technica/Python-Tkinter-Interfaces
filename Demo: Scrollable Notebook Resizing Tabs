def register_tab(
    manager: dict,
    node_key: str,
    page: tk.Frame,
    tab_widgets: dict,
) -> None:
    """
    Adds a completed tab to the application's tab registry.
    """
    manager["tabs"][node_key] = {
        "page": page,
        **tab_widgets,
    }


def select_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
    Selects an open tab in the notebook, raises its z-index, and updates visuals.
    """
    tabs_dict: dict = tab_bar_state.get("tabs", {})
    notebook: ttk.Notebook = tab_bar_state.get("notebook")
    canvas: tk.Canvas = tab_bar_state.get("canvas")
    nav_tree: ttk.Treeview | None = tab_bar_state.get("nav_tree")

    if node_key not in tabs_dict:
        return

    # Select notebook page
    tab_info = tabs_dict[node_key]

    # PHASE 1: State Selection & Z-Index Promotion ---------
    # Switch the underlying tabless notebook panel
    notebook.select(tab_info["page"])

    # Raise the active tab frame above its overlapping neighbors
    tab_info["frame"].lift()

    # PHASE 2: Visual Styling & Corner Bevels ---------------
    # Paint active tab to white and inactive tabs back to strip gray
    update_tab_bar_visuals(tab_bar_state, active_key=node_key)

    # PHASE 3: Geometry Recalculation & Title Expansion ------
    # Expands active tab to natural width, truncates compressed neighbors
    layout_overlapping_tabs(tab_bar_state)

    # PHASE 4: Scroll Alignment & External Sync ---------------
    # Ensure the newly expanded tab is not scrolled out of view
    scroll_tab_into_view(canvas, tab_info["frame"])

    # Highlight corresponding leaf node in the sidebar treeview
    if nav_tree:
        sync_sidebar_selection(nav_tree, node_key)


def update_tab_bar_visuals(tab_bar_state: dict, active_key: str | None) -> None:
    """
    Updates tab borders, button backgrounds, and dog-ear corner colors.
    """
    for node_key, item in tab_bar_state["tabs"].items():
        is_active = (node_key == active_key)
        bg_fill = CONFIG["COLOR_WORKSPACE_BG"] if is_active else CONFIG["COLOR_TAB_INACTIVE"]

        item["frame"].configure(bg=bg_fill)
        item["lbl_title"].configure(bg=bg_fill)
        item["btn_close"].configure(bg=bg_fill, activebackground=bg_fill)

        # Sync the dog-ear corner triangle fill
        if "corner" in item and "corner_poly" in item:
            item["corner"].itemconfig(
                item["corner_poly"],
                fill=bg_fill,
                outline=bg_fill
            )
            # Active tab diagonal bevel highlight
            diag_color = "#FFFFFF" if is_active else CONFIG["COLOR_BORDER"]
            item["corner"].itemconfig(item["corner_diagonal"], fill=diag_color)


# Tab Resizing Functions ------------------------------------------------------
def on_tab_strip_resize(event: tk.Event, tab_bar_state: dict) -> None:
    """
    Triggers an immediate layout recalculation when the window or tab strip resizes.
    Uses after_idle to avoid layout thrashing during active dragging.
    """
    canvas: tk.Canvas = tab_bar_state["canvas"]
    
    # Cancel any pending queued calculation to prevent lag
    pending_job = getattr(canvas, "_resize_job", None)
    if pending_job is not None:
        canvas.after_cancel(pending_job)
        
    def _recalculate():
        canvas._resize_job = None
        layout_overlapping_tabs(tab_bar_state)

    # Schedule immediate recalculation as soon as Tk finishes the resize pass
    canvas._resize_job = canvas.after_idle(_recalculate)


def truncate_text_to_width(full_text: str, font: tuple | tkfont.Font, max_pixels: int) -> str:
    """
    Truncates full_text with an ellipsis ('…') so that its rendered
    pixel width does not exceed max_pixels.

    Necessary to resizing tabs.
    """
    if max_pixels <= 10:
        return ""  # Not enough room even for an ellipsis

    # Resolve font object for exact pixel measuring
    f = font if isinstance(font, tkfont.Font) else tkfont.Font(font=font)

    if f.measure(full_text) <= max_pixels:
        return full_text

    ellipsis = "…"
    ellipsis_width = f.measure(ellipsis)

    if ellipsis_width > max_pixels:
        return ""

    budget = max_pixels - ellipsis_width

    # Trim characters until the remaining string fits the budget
    low = 0
    high = len(full_text)
    best_fit = ""

    while low <= high:
        mid = (low + high) // 2
        candidate = full_text[:mid]
        if f.measure(candidate) <= budget:
            best_fit = candidate
            low = mid + 1
        else:
            high = mid - 1

    return best_fit + ellipsis if best_fit else ellipsis


