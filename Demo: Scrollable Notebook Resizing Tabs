# Styles Setup ----------------------------------------------------------------
def setup_workspace_styles() -> ttk.Style:
    """
    Configures the theme and completely suppresses native notebook tabs.
    """
    style = ttk.Style()
    # style.theme_use("clam")
    style.configure("Treeview", rowheight=CONFIG["ROW_HEIGHT"], font=CONFIG["FONT_BODY"])

    # 1. Redefine the notebook layout so it ONLY draws the client viewport
    # This strips out the tab row entirely.
    style.layout("Tabless.TNotebook", [
        ("Tabless.TNotebook.client", {"sticky": "nswe"})
    ])

    # 2. Empty out the Tab element layout explicitly
    style.layout("Tabless.TNotebook.Tab", [])

    # 3. Collapse tab dimensions and padding to 0
    style.configure(
        "ScrollingTab.TFrame",
        background=CONFIG["COLOR_TAB_INACTIVE"],
        borderwidth=1,
        relief="raised",
    )

    style.configure(
        "ScrollingTab.TLabel",
        background=CONFIG["COLOR_TAB_INACTIVE"],
        foreground="#000000",
        padding=(8, 4),
    )

    style.configure(
        "ScrollingTabClose.TButton",
        padding=(2, 2),
        relief="flat",
    )

    style.configure(
        "Sidebar.TFrame",
        background=CONFIG["COLOR_STRIP_BG"],
    )
    style.configure(
        "Tabless.TNotebook",
        tabmargins=0,
        borderwidth=0,
        highlightthickness=0,
        background=CONFIG["COLOR_WORKSPACE_BG"],
        relief="flat",
        padding=0,
    )
    style.configure(
        "Treeview",
        rowheight=CONFIG["ROW_HEIGHT"],
        font=CONFIG["FONT_BODY"],
        bordercolor="#000000",
        lightcolor="#000000",
        darkcolor="#000000",
        borderwidth=1,
        relief="solid",
    )

    # 1. Register a square, flat block layout
    # Define a horizontal scrollbar layout
    # Clean, modern scrollbar without arrow boxes; 8px width ensures reliable mouse grabbing
    style.layout("Slim.Horizontal.TScrollbar", [
        ("Horizontal.Scrollbar.trough", {
            "sticky": "nswe",
            "children": [
                ("Horizontal.Scrollbar.thumb", {"sticky": "nswe"})
            ]
        })
    ])
    style.configure(
        "Slim.Horizontal.TScrollbar",
        troughcolor=CONFIG["COLOR_SCROLL_TROUGH"],
        background=CONFIG["COLOR_SCROLL_THUMB"],
        lightcolor=CONFIG["COLOR_SCROLL_THUMB"],
        darkcolor=CONFIG["COLOR_SCROLL_THUMB"],
        bordercolor=CONFIG["COLOR_SCROLL_TROUGH"],
        arrowsize=0,
        width=8,
        relief="flat"
    )
    style.map("Slim.Horizontal.TScrollbar",
        background=[("active", "#6B6B6B"), ("pressed", "#404040")]
    )

    return style


# Sidebar Functions -----------------------------------------------------------
def on_sidebar_click(event: tk.Event, tab_bar_state: dict) -> None:
    """
    Handles sidebar node click to open or select a tab.
    """
    treeview: ttk.Treeview = event.widget  # type: ignore[assignment]
    # Addresses error "Cannot access attribute "item"
    item = treeview.focus()

    if not item:
        return

    vals = treeview.item(item, "values")

    if vals:
        create_workspace_tab(vals[0], tab_bar_state)


def sync_sidebar_selection(treeview_widget: ttk.Treeview, active_key: str) -> None:
    """
    Highlights the corresponding node in the sidebar.
    """
    for parent_id in treeview_widget.get_children():
        for child_id in treeview_widget.get_children(parent_id):
            vals = treeview_widget.item(child_id, "values")
            if vals and vals[0] == active_key:
                if treeview_widget.focus() != child_id:
                    treeview_widget.item(parent_id, open=True)
                    treeview_widget.selection_set(child_id)
                    treeview_widget.focus(child_id)
                return


# Tab Bar Scrolling Functions -------------------------------------------------
def layout_overlapping_tabs(tab_bar_state: dict) -> None:
    """
    Positions tabs side-by-side or overlapped, dynamically adjusting
    label padding and truncating tab titles with an ellipsis.
    """
    tabs_dict: dict = tab_bar_state.get("tabs", {})

    if not tabs_dict:
            return

    canvas: tk.Canvas = tab_bar_state["canvas"]
    scroll_content: tk.Frame = tab_bar_state["scroll_content"]
    notebook: ttk.Notebook = tab_bar_state["notebook"]

    # 1. Measure current visible viewport width
    viewport_width = canvas.winfo_width()
    if viewport_width <= 1:
        viewport_width = canvas.winfo_reqwidth()
        if viewport_width <= 1:
            viewport_width = 600

    tab_items = list(tabs_dict.items())  # list of (node_key, item)
    tab_count = len(tab_items)
    # tab_height = CONFIG.get("TAB_BAR_HEIGHT", 32)    
    tab_height = CONFIG.get("TAB_BAR_HEIGHT", 26)  # Reads 26px directly
    min_tab_stride = 65  # Narrowest visible slice before horizontal scrolling starts

    # 2. Find which node_key is currently active in the notebook
    # Find which node_key is currently active in the notebook    
    active_key = None
    try:
        current_page = notebook.select()
        if current_page:
            active_key = getattr(notebook.nametowidget(current_page), "node_key", None)
    except Exception:
        pass

    # 3. Measure preferred full width of all tabs with normal text
    font_tab = CONFIG["FONT_TAB"]
    # Fixed UI element footprint: close button (~20px) + dog-ear (~9px) + borders/gaps (~9px)    
    fixed_elements_width = 38  # Approx combined width: close btn (~20px) + dogear (~9px) + borders/gaps (~9px)

    # 4. Calculate full natural width for every tab
    # Measure preferred widths
    natural_widths = []

    for node_key, item in tab_items:
        full_title = TAB_REGISTRY.get(node_key, {}).get("title", "")
        f = tkfont.Font(font=font_tab)
        w = f.measure(full_title) + fixed_elements_width + 10  # 10px = 5px padding on both sides
        natural_widths.append(w)

    total_natural_width = sum(natural_widths)

    # 5. Lay out tabs based on available space
    if total_natural_width <= viewport_width:
        # MODE 1: Normal Side-by-Side (Full Titles, Standard Padding)
        current_x = 2

        for (node_key, item), w in zip(tab_items, natural_widths):
            full_title = TAB_REGISTRY.get(node_key, {}).get("title", "")
            item["lbl_title"].configure(text=full_title, padx=5)

            # Reset standard padding & full title            
            item["frame"].place(
                x=current_x,
                y=0,
                width=w,
                height=tab_height,
                anchor="nw",
            )
            current_x += w + 2

        total_content_width = current_x

        # Lock view flush to the left edge; expand scroll area to eliminate empty space drift
        canvas.xview_moveto(0.0)
        effective_width = max(total_content_width, viewport_width)
        scroll_content.configure(width=effective_width, height=tab_height)
        canvas.configure(scrollregion=(0, 0, effective_width, tab_height))

    else:
        # MODE 2: Overlapping & Dynamic Truncation

        # Active tab gets full natural width. Remaining space is divided among inactive tabs.
        active_idx = 0
        for idx, (node_key, _) in enumerate(tab_items):
            if node_key == active_key:
                active_idx = idx
                break

        active_width = natural_widths[active_idx]
        remaining_space = viewport_width - active_width

        # Calculate stride for inactive tabs
        if tab_count > 1:
            available_stride = remaining_space / (tab_count - 1)
        else:
            available_stride = min_tab_stride        

        # Calculate stride between tab origins
        # available_stride = (viewport_width - natural_widths[-1]) / max(1, tab_count - 1)        
        stride = max(min_tab_stride, available_stride)
        is_tight = stride < 110

        current_x = 0
        for i, (node_key, item) in enumerate(tab_items):
            is_active = (node_key == active_key)
            is_last = (i == tab_count - 1)
            full_title = TAB_REGISTRY.get(node_key, {}).get("title", "")

            # 1. Compress padding when tight
            title_pad = 2 if is_tight else 5
            item["lbl_title"].configure(padx=title_pad)

            # 2. Determine actual placed frame width
            # Inactive tabs are physically sized to 'stride' so text cannot bleed to the right.
            # Active tabs and the final tab retain full width.
            if is_active or is_last:
                placed_w = natural_widths[i]
                visible_slot = natural_widths[i]
            else:
                placed_w = int(stride)
                visible_slot = stride

            # 3. Dynamic title truncation for the visible slice
            # Deduct close button (~20px), dog ear (~9px), borders, and padding
            overhead = fixed_elements_width + (title_pad * 2)
            text_budget = max(0, int(visible_slot - overhead))

            # 4. Apply ellipsis truncation
            truncated_title = truncate_text_to_width(full_title, font_tab, text_budget)
            item["lbl_title"].configure(text=truncated_title)

            # 5. Place tab: inactive tabs now strictly occupy their visible slice
            item["frame"].place(
                x=int(current_x),
                y=0,
                width=placed_w,
                height=tab_height,
                anchor="nw",
            )
            # current_x += stride

            # Advance current_x by the actual visible width of THIS tab
            if is_active:
                current_x += natural_widths[i]
            else:
                current_x += stride

        total_content_width = int((current_x - stride) + natural_widths[-1])

        # Update scroll region
        scroll_content.configure(width=total_content_width, height=tab_height)
        canvas.configure(scrollregion=(0, 0, total_content_width, tab_height))

    # 6. Maintain Z-index: Ensure the active tab always rests on top
    # Lift ONLY the active tab so its full width, dog-ear, and borders sit on top of everything
    if active_key and active_key in tabs_dict:
        tabs_dict[active_key]["frame"].lift()


def on_tab_bar_mousewheel(event: tk.Event, canvas: tk.Canvas) -> None:
    """
    Scrolls the tab bar horizontally using the mouse wheel.  Blocked if all tabs 
    fit inside viewport at maximum width. This prevents all of the tabs from 
    being pulled all of the way to the right.
    """
    canvas.update_idletasks()
    viewport_width = canvas.winfo_width()
    bbox = canvas.bbox("all")
    content_width = (bbox[2] - bbox[0]) if bbox else 0

    if content_width <= viewport_width:
        canvas.xview_moveto(0.0)
        return

    # Linux (Button-4 / Button-5) vs Windows/macOS (delta)
    if event.num == 4:
        delta = -1
    elif event.num == 5:
        delta = 1
    else:
        delta = -1 if event.delta > 0 else 1

    canvas.xview_scroll(delta * 2, "units")


def scroll_tab_bar(canvas: tk.Canvas, direction: int) -> None:
    """
    Scrolls the canvas horizontally. Disabled when all tabs fit within the viewport.
    """
    canvas.update_idletasks()
    viewport_width = canvas.winfo_width()
    
    # Read the current bounding box / scrollable area
    bbox = canvas.bbox("all")
    content_width = (bbox[2] - bbox[0]) if bbox else 0

    # If the tabs fit comfortably within view, pin flush to the left
    if content_width <= viewport_width:
        canvas.xview_moveto(0.0)
        return

    # Normal scrolling when tabs actually overflow
    canvas.xview_scroll(direction * 3, "units")


def scroll_tab_into_view(canvas: tk.Canvas, tab_frame: tk.Frame) -> None:
    """
    Ensures the active tab is visible in the scrollable viewport.
    """
    canvas.update_idletasks()
    tab_frame.update_idletasks()

    viewport_width = canvas.winfo_width()
    bbox = canvas.bbox("all")

    if not bbox or (bbox[2] - bbox[0]) <= viewport_width:
        # If tabs fit inside the viewport, enforce zero-offset pin
        canvas.xview_moveto(0.0)
        return

    content_width = bbox[2] - bbox[0]
    tab_x = tab_frame.winfo_x()
    tab_w = tab_frame.winfo_width()

    # Canvas current visible boundaries in pixel coordinates
    left_vis = canvas.xview()[0] * content_width
    right_vis = canvas.xview()[1] * content_width

    # Tab is tucked past the right edge -> pan right
    if (tab_x + tab_w) > right_vis:
        target = (tab_x + tab_w - viewport_width) / content_width
        canvas.xview_moveto(max(0.0, min(1.0, target)))
    # Tab is tucked past the left edge -> pan left
    elif tab_x < left_vis:
        target = tab_x / content_width
        canvas.xview_moveto(max(0.0, min(1.0, target)))


# Tab Creation ----------------------------------------------------------------
def _apply_tab_decorations(tab_item: tk.Frame) -> tuple[tk.Canvas, int, int]:
    """
    Applies the 3-sided border bevels and top-right corner dog-ear overlay.
    """
    # 3-sided border bevels: Top line stops 9px short of the right edge to avoid crossing the dog ear
    tk.Frame(tab_item, bg="#FFFFFF", height=1).place(
        x=0, y=0, relwidth=1.0, width=-9, anchor="nw"
    )
    tk.Frame(tab_item, bg="#FFFFFF", width=1).place(
        x=0, y=0, relheight=1.0, anchor="nw"
    )
    tk.Frame(tab_item, bg=CONFIG["COLOR_BORDER"], width=1).place(
        relx=1.0, x=-1, y=9, relheight=1.0, height=-9, anchor="ne"
    )

    # Corner dog-ear canvas: background MUST match the scrolling strip background
    corner_canvas = tk.Canvas(
        tab_item,
        width=9,
        height=9,
        bg=CONFIG["COLOR_STRIP_BG"],
        borderwidth=0,
        highlightthickness=0,
    )
    corner_canvas.place(relx=1.0, rely=0.0, anchor="ne")

    # Lower-left triangle filled with the tab's body color
    corner_poly = corner_canvas.create_polygon(
        0, 0,
        0, 9,
        9, 9,
        fill=CONFIG["COLOR_TAB_INACTIVE"],
        outline=CONFIG["COLOR_TAB_INACTIVE"]
    )

    # Diagonal cut line separating the tab from the strip
    corner_diagonal = corner_canvas.create_line(
        0, 0,
        9, 9,
        fill=CONFIG["COLOR_BORDER"],
        width=1
    )

    return corner_canvas, corner_poly, corner_diagonal


def _bind_tab_events(
    node_key: str,
    tab_bar_state: dict,
    tab_item: tk.Frame,
    lbl_title: tk.Label,
    btn_close: tk.Button,
    corner_canvas: tk.Canvas,
) -> None:
    """
    Attach selection, close-click, hover, and scroll forwarding bindings.
    """
    # Close button hover effect
    btn_close.bind("<Enter>", lambda e, b=btn_close: b.configure(fg="#E81123"))
    btn_close.bind("<Leave>", lambda e, b=btn_close: b.configure(fg="#555555"))

    # Select / Close triggers across tab sub-elements
    interactive_elements = (tab_item, lbl_title, corner_canvas)

    for element in interactive_elements:
        element.bind("<Button-1>", lambda e, k=node_key: select_workspace_tab(k, tab_bar_state))
        element.bind("<Button-2>", lambda e, k=node_key: close_workspace_tab(k, tab_bar_state))

    btn_close.bind("<Button-1>", lambda e, k=node_key: close_workspace_tab(k, tab_bar_state))

    # Mousewheel forwarding
    canvas = tab_bar_state["canvas"]
    all_elements = (*interactive_elements, btn_close)
    for widget in all_elements:
        widget.bind("<MouseWheel>", lambda e, c=canvas: on_tab_bar_mousewheel(e, c))
        widget.bind("<Button-4>", lambda e, c=canvas: on_tab_bar_mousewheel(e, c))
        widget.bind("<Button-5>", lambda e, c=canvas: on_tab_bar_mousewheel(e, c))


def _build_tab_button(parent: tk.Misc, node_key: str, tab_meta: dict, tab_bar_state: dict) -> tuple[tk.Frame, tk.Label, tk.Button]:
    """
    Instantiate the tab item frame, title label, and close button.
    """
    tab_item = tk.Frame(
        parent,
        bg=CONFIG["COLOR_TAB_INACTIVE"],
        borderwidth=0,
        relief="flat",
    )

    lbl_title = tk.Label(
        tab_item,
        text=tab_meta["title"],
        font=CONFIG["FONT_TAB"],
        bg=CONFIG["COLOR_TAB_INACTIVE"],
        fg="#000000",
        padx=5,
        pady=1,
        anchor="w",  # Pins text to the left
        cursor="hand2",
    )
    lbl_title.pack(side="left", fill="x", expand=True)

    btn_close = tk.Button(
        tab_item,
        text="×",
        font=CONFIG["FONT_CLOSE"],
        relief="flat",
        borderwidth=0,
        highlightthickness=0,
        overrelief="flat",
        bg=CONFIG["COLOR_TAB_INACTIVE"],
        fg="#555555",
        activebackground=CONFIG["COLOR_TAB_INACTIVE"],
        cursor="hand2",
        command=lambda k=node_key: close_workspace_tab(k, tab_bar_state),
    )
    btn_close.pack(side="right", fill="y", padx=(0, 4))

    return tab_item, lbl_title, btn_close


def _build_workspace_page(notebook: ttk.Notebook, node_key: str, tab_meta: dict) -> tk.Frame:
    """
    Build and mouns the workspace notebook panel.
    """
    page_frame = tk.Frame(
        notebook,
        bg=CONFIG["COLOR_WORKSPACE_BG"],
        highlightbackground="#000000",
        highlightthickness=1,
        highlightcolor="#000000",
    )
    page_frame.node_key = node_key

    ttk.Label(
        page_frame,
        text=tab_meta["header"],
        font=CONFIG["FONT_HEADER"],
        background=CONFIG["COLOR_WORKSPACE_BG"],
    ).pack(anchor="w", padx=25, pady=25)

    ttk.Label(
        page_frame,
        text=f"Active Context: [{tab_meta['title']}]",
        font=CONFIG["FONT_BODY"],
        background=CONFIG["COLOR_WORKSPACE_BG"],
    ).pack(anchor="w", padx=25)

    notebook.add(page_frame)

    return page_frame


def create_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
    Coordinate lifecycle, layout, and registration of each workspace tab.
    """
    tabs_dict = tab_bar_state["tabs"]
    tab_meta = TAB_REGISTRY.get(node_key)    

    if not tab_meta:
        return

    if node_key in tabs_dict:
        select_workspace_tab(node_key, tab_bar_state)
        return

    # 1. Workspace Notebook Page
    page_frame = _build_workspace_page(tab_bar_state["notebook"], node_key, tab_meta)

    # 2. Tab Strip Button & Elements
    tab_item, lbl_title, btn_close = _build_tab_button(
        tab_bar_state["scroll_content"], node_key, tab_meta, tab_bar_state
    )

    # 3. Visual Accents & Geometry
    corner_canvas, corner_poly, corner_diagonal = _apply_tab_decorations(tab_item)

    # 4. Event & Interaction Bindings
    _bind_tab_events(node_key, tab_bar_state, tab_item, lbl_title, btn_close, corner_canvas)

    # 5. State Registration & Presentation
    tabs_dict[node_key] = {
        "page": page_frame,
        "frame": tab_item,
        "lbl_title": lbl_title,
        "btn_close": btn_close,
        "corner": corner_canvas,
        "corner_poly": corner_poly,
        "corner_diagonal": corner_diagonal,
    }

    layout_overlapping_tabs(tab_bar_state)
    select_workspace_tab(node_key, tab_bar_state)


# Tab Functions ---------------------------------------------------------------
def bind_tab_events(
    tab_widgets: dict,
    node_key: str,
    manager: dict,
) -> None:
    """
    Binds selection, closing, hover, and scrolling events.
    """
    tab_item = tab_widgets["frame"]
    lbl_title = tab_widgets["lbl_title"]
    btn_close = tab_widgets["btn_close"]
    corner_canvas = tab_widgets["corner"]

    select_tab = lambda event: select_workspace_tab(node_key, manager)
    close_tab = lambda event: close_workspace_tab(node_key, manager)
    scroll_tabs = lambda event: on_tab_bar_mousewheel(
        event,
        manager["canvas"],
    )

    tab_item.bind("<Button-1>", select_tab)
    tab_item.bind("<Button-2>", close_tab)

    lbl_title.bind("<Button-1>", select_tab)
    lbl_title.bind("<Button-2>", close_tab)

    corner_canvas.bind("<Button-1>", select_tab)
    corner_canvas.bind("<Button-2>", close_tab)

    # The Button command handles normal left-click closing.
    # Do not also bind btn_close to <Button-1>, or it may close twice.

    btn_close.bind(
        "<Enter>",
        lambda event: btn_close.configure(fg="#E81123"),
    )
    btn_close.bind(
        "<Leave>",
        lambda event: btn_close.configure(fg="#555555"),
    )

    for widget in (tab_item, lbl_title, btn_close, corner_canvas):
        widget.bind("<MouseWheel>", scroll_tabs)
        widget.bind("<Button-4>", scroll_tabs)
        widget.bind("<Button-5>", scroll_tabs)


def close_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
    Closes a workspace tab, destroys its associated UI widgets to prevent
    memory leaks, recalculates layout compression, and shifts active focus.

    Closes a tab and selects its neighbor:
    - If the closed tab was active: selects the next tab to the right.
      If none exists to the right, selects the tab to the left.
    - If the closed tab was inactive: maintains current active tab selection.
    """
    tabs_dict: dict = tab_bar_state.get("tabs", {})
    notebook: ttk.Notebook = tab_bar_state.get("notebook")
    canvas: tk.Canvas = tab_bar_state.get("canvas")
    nav_tree: ttk.Treeview | None = tab_bar_state.get("nav_tree")

    if node_key not in tabs_dict:
        return

    # 1. Pop tab state dictionary entry
    tab_info = tabs_dict.pop(node_key)

    # 2. Destroy the tab button in the tab bar
    if "frame" in tab_info and tab_info["frame"].winfo_exists():
        tab_info["frame"].destroy()

    # 3. Remove and destroy the notebook content frame
    if "page" in tab_info and tab_info["page"].winfo_exists():
        notebook.forget(tab_info["page"])
        tab_info["page"].destroy()

    # 4. If tabs remain, select the most recently opened/adjacent tab
    if tabs_dict:
        next_key = list(tabs_dict.keys())[-1]
        select_workspace_tab(next_key, tab_bar_state)
    else:
        # Clear sidebar selection if all tabs are closed
        if nav_tree:
            nav_tree.selection_set()

    # 5. Recompute tab overlap widths and scrolling boundaries
    layout_overlapping_tabs(tab_bar_state)


def create_tab_widget(
    parent: tk.Widget,
    node_key: str,
    metadata: dict,
    manager: dict,
) -> dict:
    """
    Creates the visual tab controls for a workspace tab.
    """
    tab_item = tk.Frame(
        parent,
        bg=CONFIG["COLOR_TAB_INACTIVE"],
        borderwidth=0,
        relief="flat",
    )

    lbl_title = tk.Label(
        tab_item,
        text=metadata["title"],
        font=CONFIG["FONT_TAB"],
        bg=CONFIG["COLOR_TAB_INACTIVE"],
        fg="#000000",
        padx=5,
        pady=4,
        cursor="hand2",
    )
    lbl_title.pack(side="left")

    btn_close = tk.Button(
        tab_item,
        text="×",
        font=CONFIG["FONT_CLOSE"],
        relief="flat",
        borderwidth=0,
        highlightthickness=0,
        overrelief="flat",
        bg=CONFIG["COLOR_TAB_INACTIVE"],
        fg="#555555",
        activebackground=CONFIG["COLOR_TAB_INACTIVE"],
        cursor="hand2",
        command=lambda: close_workspace_tab(node_key, manager),
    )
    btn_close.pack(side="left", padx=(0, 6))

    # Three-sided bevel.
    tk.Frame(tab_item, bg="#FFFFFF", height=1).place(
        x=0,
        y=0,
        relwidth=1.0,
        anchor="nw",
    )
    tk.Frame(tab_item, bg="#FFFFFF", width=1).place(
        x=0,
        y=0,
        relheight=1.0,
        anchor="nw",
    )
    tk.Frame(tab_item, bg=CONFIG["COLOR_BORDER"], width=1).place(
        relx=1.0,
        x=-1,
        y=0,
        relheight=1.0,
        anchor="ne",
    )

    corner_canvas = tk.Canvas(
        tab_item,
        width=9,
        height=9,
        bg=CONFIG["COLOR_STRIP_BG"],
        borderwidth=0,
        highlightthickness=0,
    )
    corner_canvas.place(relx=1.0, rely=0.0, anchor="ne")

    corner_canvas.create_polygon(
        0, 0,
        0, 9,
        9, 9,
        fill=CONFIG["COLOR_TAB_INACTIVE"],
        width=1,
    )
    corner_top_line = corner_canvas.create_line(
        0,
        0,
        9,
        0,
        fill="#FFFFFF",
        width=1,
    )

    return {
        "frame": tab_item,
        "lbl_title": lbl_title,
        "btn_close": btn_close,
        "corner": corner_canvas,
        "corner_top_line": corner_top_line,
    }


