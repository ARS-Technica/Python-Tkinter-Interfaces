def register_tab(
    manager: dict,
    node_key: str,
    page: tk.Frame,
    tab_widgets: dict,
) -> None:
    """
    Adds a completed tab to the application's tab registry.
    """
    manager["tabs"][node_key] = {
        "page": page,
        **tab_widgets,
    }


def select_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
    Updates background colors to reflect the active tab.
    """
    notebook = tab_bar_state["notebook"]
    tabs_dict = tab_bar_state["tabs"]
    nav_tree = tab_bar_state["nav_tree"]

    if node_key not in tabs_dict:
        return

    # Select notebook page
    tab_info = tabs_dict[node_key]
    notebook.select(tab_info["page"])

    # Update visuals & auto-scroll
    update_tab_bar_visuals(tab_bar_state, node_key)
    scroll_tab_into_view(tab_bar_state["canvas"], tab_info["frame"])

    # Sync Treeview selection
    sync_sidebar_selection(nav_tree, node_key)


def update_tab_bar_visuals(tab_bar_state: dict, active_key: str | None) -> None:
    """
    Updates tab borders, baseline connectors, and background colors.
    """
    active_frame = None
    tab_items = list(tab_bar_state["tabs"].items())

    for index, (node_key, item) in enumerate(tab_items):
        is_active = (node_key == active_key)

        bg_fill = CONFIG["COLOR_WORKSPACE_BG"] if is_active else CONFIG["COLOR_TAB_INACTIVE"]

        # Color the tab frame
        item["frame"].configure(bg=bg_fill)
        item["lbl_title"].configure(bg=bg_fill)
        item["btn_close"].configure(bg=bg_fill)
        beneath_fill = CONFIG["COLOR_STRIP_BG"]
        if index + 1 < len(tab_items):
            beneath_fill = (
                CONFIG["COLOR_WORKSPACE_BG"]
                if tab_items[index + 1][0] == active_key
                else CONFIG["COLOR_TAB_INACTIVE"]
            )
        item["corner"].configure(bg=beneath_fill)
        item["corner"].itemconfigure(1, fill=bg_fill)
        hide_corner_line = index == len(tab_items) - 1
        item["corner"].itemconfigure(
            item["corner_top_line"],
            state="hidden" if hide_corner_line else "normal",
        )

        if is_active:
            active_frame = item["frame"]

    if active_frame is not None:
        active_frame.lift()


# Tab Resizing Functions ------------------------------------------------------
def truncate_text_to_width(full_text: str, font: tuple | tkfont.Font, max_pixels: int) -> str:
    """
    Truncates full_text with an ellipsis ('…') so that its rendered
    pixel width does not exceed max_pixels.

    Necessary to resizing tabs.
    """
    if max_pixels <= 10:
        return ""  # Not enough room even for an ellipsis

    # Resolve font object for exact pixel measuring
    f = font if isinstance(font, tkfont.Font) else tkfont.Font(font=font)

    if f.measure(full_text) <= max_pixels:
        return full_text

    ellipsis = "…"
    ellipsis_width = f.measure(ellipsis)

    if ellipsis_width > max_pixels:
        return ""

    budget = max_pixels - ellipsis_width

    # Trim characters until the remaining string fits the budget
    low = 0
    high = len(full_text)
    best_fit = ""

    while low <= high:
        mid = (low + high) // 2
        candidate = full_text[:mid]
        if f.measure(candidate) <= budget:
            best_fit = candidate
            low = mid + 1
        else:
            high = mid - 1

    return best_fit + ellipsis if best_fit else ellipsis


# Widget Layout Functions -----------------------------------------------------
def build_sidebar_panel(parent: ttk.PanedWindow) -> tuple[ttk.Frame, ttk.Treeview]:
    """
    Builds the left-side hierarchical navigation Treeview with a 3-tier structure:
    Tier 1: Root Clusters -> Tier 2: Category Sub-Folders -> Tier 3: Workspaces.
    """
    sidebar_frame = ttk.Frame(parent, height=10, width=250, relief="flat")
    sidebar_frame.pack_propagate(False)

    # 1. Sidebar Header
    sidebar_header = ttk.Label(
        sidebar_frame, 
        text="💻 System Clusters", 
        font=CONFIG["FONT_HEADER"],
        anchor="center"
    )
    sidebar_header.pack(anchor="w", fill="x", padx=10, pady=(10, 15))

    # 2. Hierarchical Treeview
    nav_tree = ttk.Treeview(sidebar_frame, show="tree", selectmode="browse")
    nav_tree.pack(fill="both", expand=True, padx=5, pady=(0, 5))

    # --- Tier 1: Root Cluster Folders ---
    cluster_dev = nav_tree.insert("", tk.END, text="📁 Core Development Stack")
    cluster_adm = nav_tree.insert("", tk.END, text="📁 Server Administration Space")

    # --- Tier 2: Development Sub-Folders ---
    folder_dev_tools = nav_tree.insert(cluster_dev, tk.END, text="📂 Developer Tooling")
    folder_dev_traffic = nav_tree.insert(cluster_dev, tk.END, text="📂 Services & Traffic")

    # Tier 3: Development Workspace Leaves
    nav_tree.insert(folder_dev_tools, tk.END, text="💻 Shell Terminal Console", values=("dev_shell",))
    nav_tree.insert(folder_dev_tools, tk.END, text="🌿 Source Version Control", values=("dev_git",))
    nav_tree.insert(folder_dev_traffic, tk.END, text="📊 Analytics Dashboard", values=("dev_dash",))
    nav_tree.insert(folder_dev_traffic, tk.END, text="🌐 API Gateway Inspector", values=("dev_api",))

    # --- Tier 2: Administration Sub-Folders ---
    folder_adm_security = nav_tree.insert(cluster_adm, tk.END, text="📂 Security & Governance")
    folder_adm_telemetry = nav_tree.insert(cluster_adm, tk.END, text="📂 Diagnostics & Health")

    # Tier 3: Administration Workspace Leaves
    nav_tree.insert(folder_adm_security, tk.END, text="⚙️ Global System Rules", values=("adm_rules",))
    nav_tree.insert(folder_adm_security, tk.END, text="🔒 Database Key Vault", values=("adm_vault",))
    nav_tree.insert(folder_adm_telemetry, tk.END, text="📋 Live Server Logs", values=("adm_logs",))
    nav_tree.insert(folder_adm_telemetry, tk.END, text="📈 Performance Monitor", values=("adm_perf",))

    # Automatically expand folders on launch
    for folder in (cluster_dev, cluster_adm, folder_dev_tools, folder_dev_traffic, folder_adm_security, folder_adm_telemetry):
        nav_tree.item(folder, open=True)

    return sidebar_frame, nav_tree


def build_workspace(parent: ttk.PanedWindow) -> tuple[ttk.Frame, dict]:
    """
    Builds the right-hand panel containing the scrollable tab strip and notebook.
    """
    workspace_container = ttk.Frame(parent)

    # 1. Top Scrollable Tabs in Header Bar
    tab_strip_frame = tk.Frame(
        workspace_container,
        height=CONFIG["TAB_BAR_HEIGHT"],
        bg=CONFIG["COLOR_STRIP_BG"],
        borderwidth=0,
        highlightthickness=0,
    )
    tab_strip_frame.pack(side="top", fill="x")
    tab_strip_frame.pack_propagate(False)


    # 2. Canvas & Inner Content
    # Must exist BEFORE binding scrollbar commands
    canvas = tk.Canvas(
        tab_strip_frame,
        height=CONFIG["TAB_BAR_HEIGHT"],
        bg=CONFIG["COLOR_STRIP_BG"],
        borderwidth=0,
        highlightthickness=0,
    )

    btn_left = tk.Button(
        tab_strip_frame, text="◀", relief="flat", bg="#CCCCCC", width=3, height=1,
        command=lambda: scroll_tab_bar(canvas, -1)
    )
    btn_left.pack(
        side="left",
        anchor="s",
        padx=(1, 0),
        pady=(0, 0),
        ipady=0,
    )

    btn_right = tk.Button(
        tab_strip_frame, text="▶", relief="flat", bg="#CCCCCC", width=3, height=1,
        command=lambda: scroll_tab_bar(canvas, 1)
    )
    btn_right.pack(
        side="right",
        anchor="s",
        padx=(0, 3),
        pady=(0, 0),
        ipady=0,
    )

    canvas.pack(side="left", fill="both", expand=True)


    # 3. Canvas Window
    scroll_content = tk.Frame(
        canvas,
        bg=CONFIG["COLOR_STRIP_BG"],
        borderwidth=0,
        highlightthickness=0,
    )
    canvas_window = canvas.create_window(
        (0, CONFIG["TAB_BAR_HEIGHT"]),
        window=scroll_content,
        anchor="sw",
        height=CONFIG["TAB_BAR_HEIGHT"],
    )

    # Keep canvas window height matched
    scroll_content.bind(
        "<Configure>",
        lambda e: canvas.configure(scrollregion=canvas.bbox("all")),
    )

    # Mousewheel scrolling over the canvas strip
    for w in (canvas, scroll_content, tab_strip_frame):
        w.bind("<MouseWheel>", lambda e: on_tab_bar_mousewheel(e, canvas))
        w.bind("<Button-4>", lambda e: on_tab_bar_mousewheel(e, canvas))
        w.bind("<Button-5>", lambda e: on_tab_bar_mousewheel(e, canvas))


    # 4. Horizontal Scrollbar Container Frame 
    # (Separates mouse hit target from Canvas & Notebook)
    # Dedicated container frame so mouse clicks are never clipped
    scrollbar_container = tk.Frame(
        workspace_container, 
        height=8, # Horizonyal Scrollbar Style Thickness
        bg=CONFIG["COLOR_SCROLL_TROUGH"]
    )
    scrollbar_container.pack(side="top", fill="x")
    scrollbar_container.pack_propagate(False)

    # Instantiate the scrollbar inside its container
    tab_scrollbar = ttk.Scrollbar(
        scrollbar_container,
        orient="horizontal",
        style="Slim.Horizontal.TScrollbar",
        command=canvas.xview
    )
    tab_scrollbar.pack(fill="both", expand=True)

    # Connect canvas horizontal movement to the scrollbar thumb
    canvas.configure(xscrollcommand=tab_scrollbar.set)


    # 5. Bottom Tabless Notebook Workspace
    notebook = ttk.Notebook(workspace_container, style="Tabless.TNotebook")
    notebook.pack(side="top", fill="both", expand=True)

    tab_bar_state = {
        "canvas": canvas,
        "canvas_window": canvas_window,
        "scroll_content": scroll_content,
        "notebook": notebook,
        "tabs": {},
        "nav_tree": None,
    }

    return workspace_container, tab_bar_state


# Master Interface Coordinator ------------------------------------------------
def create_application() -> None:
    """
    Sets up the window and initializes all workspace components.
    """
    root = tk.Tk()
    root.title(CONFIG["WINDOW_TITLE"])
    root.geometry(CONFIG["WINDOW_GEOMETRY"])

    setup_workspace_styles()

    paned_window = ttk.PanedWindow(root, orient=tk.HORIZONTAL)
    paned_window.pack(fill="both", expand=True, padx=10, pady=10)

    # Build Left & Right Panes
    sidebar_frame, nav_tree = build_sidebar_panel(paned_window)
    workspace_frame, tab_bar_state = build_workspace(paned_window)
    tab_bar_state["nav_tree"] = nav_tree

    paned_window.add(sidebar_frame, weight=0)
    paned_window.add(workspace_frame, weight=1)

    # Bind Sidebar Click Event
    nav_tree.bind("<ButtonRelease-1>", lambda e: on_sidebar_click(e, tab_bar_state))

    # Launch with initial default tab
    create_workspace_tab("dev_dash", tab_bar_state)

    root.mainloop()


if __name__ == "__main__":
    create_application()

