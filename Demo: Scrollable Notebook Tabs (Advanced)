# Styles Setup ----------------------------------------------------------------
def setup_workspace_styles() -> ttk.Style:
    """
    Configures the theme and completely suppresses native notebook tabs.
    Configures the theme, tabless notebook, and thin micro-scrollbar.
    """
    style = ttk.Style()
    style.theme_use("clam")
    style.configure("Treeview", rowheight=CONFIG["ROW_HEIGHT"], font=CONFIG["FONT_BODY"])

    # 1. Notebook viewport with zero margins
    # This strips out the tab row entirely.
    style.layout("Tabless.TNotebook", [
        ("Tabless.TNotebook.client", {"sticky": "nswe"})
    ])

    # 2. Empty out the Tab element layout explicitly
    style.layout("Tabless.TNotebook.Tab", [])

    style.configure(
        "Tabless.TNotebook",
        tabmargins=0,
        borderwidth=0,
        highlightthickness=0,
        background=CONFIG["COLOR_WORKSPACE_BG"]
    )

    # Slim Micro-Scrollbar: 4px height with hidden directional arrows
    style.layout("Slim.Horizontal.TScrollbar", [
        ("Horizontal.Scrollbar.trough", {
            "sticky": "we",
            "children": [
                ("Horizontal.Scrollbar.thumb", {"sticky": "nswe"})
            ]
        })
    ])

    style.configure(
        "Slim.Horizontal.TScrollbar",
        troughcolor=CONFIG["COLOR_SCROLL_TROUGH"],
        background=CONFIG["COLOR_SCROLL_THUMB"],
							  
        lightcolor=CONFIG["COLOR_SCROLL_THUMB"],
        darkcolor=CONFIG["COLOR_SCROLL_THUMB"],
        bordercolor=CONFIG["COLOR_SCROLL_TROUGH"],
        arrowsize=0,
        width=4,
        relief="flat"
    )
    # Hover effect for scrollbar thumb
    style.map("Slim.Horizontal.TScrollbar",
        background=[("active", "#757575"), ("pressed", "#424242")]
    )

    return style


# Tab Bar Scrolling & Interaction ---------------------------------------------

def scroll_tab_bar(canvas: tk.Canvas, direction: int) -> None:
    """
	Scrolls the canvas horizontally by units.
	"""
    canvas.xview_scroll(direction * 2, "units")


def on_tab_bar_mousewheel(event: tk.Event, canvas: tk.Canvas) -> None:
    """
    Scrolls the tab bar horizontally using the mouse wheel.
    """
    if event.delta:
        scroll_tab_bar(canvas, -1 if event.delta > 0 else 1)
    elif event.num == 4:
        scroll_tab_bar(canvas, -1)
    elif event.num == 5:
        scroll_tab_bar(canvas, 1)


def scroll_tab_into_view(canvas: tk.Canvas, tab_item: tk.Frame) -> None:
    """
	Ensures active tab is centered/visible in the viewport.
	"""
    canvas.update_idletasks()

    tab_x = tab_item.winfo_x()
    tab_w = tab_item.winfo_width()
    canvas_w = canvas.winfo_width()

    scroll_region = canvas.bbox("all")
    if not scroll_region or scroll_region[2] <= canvas_w:
        return

    total_w = scroll_region[2]
    current_left = canvas.xview()[0] * total_w
    current_right = current_left + canvas_w

    if tab_x < current_left:
        canvas.xview_moveto(max(0.0, tab_x / total_w))
    elif (tab_x + tab_w) > current_right:
        canvas.xview_moveto(min(1.0, (tab_x + tab_w - canvas_w + 30) / total_w))


# Tab Lifecycle Management ---------------------------------------------------
def update_tab_bar_visuals(tab_bar_state: dict, active_key: str | None) -> None:
    """
	Updates tab borders, baseline connectors, and background colors.
	"""
    for node_key, item in tab_bar_state["tabs"].items():
        is_active = (node_key == active_key)
        bg_fill = CONFIG["COLOR_WORKSPACE_BG"] if is_active else CONFIG["COLOR_TAB_INACTIVE"]

        item["body"].configure(bg=bg_fill)
        item["lbl_title"].configure(bg=bg_fill)
        item["btn_close"].configure(bg=bg_fill)

        bottom_line_color = CONFIG["COLOR_WORKSPACE_BG"] if is_active else CONFIG["COLOR_BORDER"]
        item["bottom_gap"].configure(bg=bottom_line_color)


def select_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
	Selects an open tab in the notebook and updates seamless styling.
	"""
    notebook = tab_bar_state["notebook"]
    tabs_dict = tab_bar_state["tabs"]
    nav_tree = tab_bar_state["nav_tree"]

    if node_key not in tabs_dict:
        return

    tab_info = tabs_dict[node_key]
    notebook.select(tab_info["page"])
								  
    update_tab_bar_visuals(tab_bar_state, node_key)
    scroll_tab_into_view(tab_bar_state["canvas"], tab_info["tab_root"])
    sync_sidebar_selection(nav_tree, node_key)


# Tab Functions ---------------------------------------------------------------
def close_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
    Closes and deallocates a tab frame and its tab-strip button.
    """
    notebook = tab_bar_state["notebook"]
    tabs_dict = tab_bar_state["tabs"]

    if node_key not in tabs_dict:
        return

    tab_info = tabs_dict.pop(node_key)
    tab_info["tab_root"].destroy()

    # Destroy page in notebook
    notebook.forget(tab_info["page"])
    tab_info["page"].destroy()

    tab_bar_state["canvas"].update_idletasks()
    tab_bar_state["canvas"].configure(scrollregion=tab_bar_state["canvas"].bbox("all"))

    # Switch focus to the latest tab if any remain
    if tabs_dict:
        next_key = list(tabs_dict.keys())[-1]
        select_workspace_tab(next_key, tab_bar_state)
    else:
        tab_bar_state["nav_tree"].selection_set()


def spawn_workspace_tab(node_key: str, tab_bar_state: dict) -> None:
    """
	Spawns a workspace page and builds a bottom-borderless native tab.
	"""
    tabs_dict = tab_bar_state["tabs"]
    notebook = tab_bar_state["notebook"]
    scroll_content = tab_bar_state["scroll_content"]
    tab_meta = TAB_REGISTRY.get(node_key)

    if not tab_meta:
        return
							  
    if node_key in tabs_dict:
        select_workspace_tab(node_key, tab_bar_state)
        return

    # 1. Workspace Notebook Page
    page_frame = tk.Frame(notebook, bg=CONFIG["COLOR_WORKSPACE_BG"])
    page_frame.node_key = node_key

    ttk.Label(page_frame, text=tab_meta["header"], font=CONFIG["FONT_HEADER"], background=CONFIG["COLOR_WORKSPACE_BG"]).pack(anchor="w", padx=25, pady=25)
    ttk.Label(page_frame, text=f"Active Context: [{tab_meta['title']}]", font=CONFIG["FONT_BODY"], background=CONFIG["COLOR_WORKSPACE_BG"]).pack(anchor="w", padx=25)
    notebook.add(page_frame)

    # 2. Native-Look Tab Structure
    tab_root = tk.Frame(scroll_content, bg=CONFIG["COLOR_BORDER"], height=32)
    tab_root.pack(side="left", padx=(3, 0), anchor="s")

    tab_body = tk.Frame(tab_root, bg=CONFIG["COLOR_TAB_INACTIVE"])
	
    tab_body.pack(side="top", fill="both", expand=True, padx=(1, 1), pady=(1, 0))

    lbl_title = tk.Label(
        tab_body, text=tab_meta["title"], font=CONFIG["FONT_TAB"],
        bg=CONFIG["COLOR_TAB_INACTIVE"], padx=8, pady=4, cursor="hand2"
    )
    lbl_title.pack(side="left")

    btn_close = tk.Label(
        tab_body, text="✕", font=CONFIG["FONT_CLOSE"],
					  
        fg="#666666", bg=CONFIG["COLOR_TAB_INACTIVE"], padx=6, pady=4, cursor="hand2"
																									 
    )
    btn_close.pack(side="right")

    bottom_gap = tk.Frame(tab_root, height=1, bg=CONFIG["COLOR_BORDER"])
    bottom_gap.pack(side="bottom", fill="x")
						 
    btn_close.bind("<Enter>", lambda e, b=btn_close: b.configure(fg="#E81123"))
    btn_close.bind("<Leave>", lambda e, b=btn_close: b.configure(fg="#666666"))

    for w in (tab_root, tab_body, lbl_title):
        w.bind("<Button-1>", lambda e, k=node_key: select_workspace_tab(k, tab_bar_state))
																																 
    btn_close.bind("<Button-1>", lambda e, k=node_key: close_workspace_tab(k, tab_bar_state))

    for widget in (tab_root, tab_body, lbl_title, btn_close):
        widget.bind("<MouseWheel>", lambda e: on_tab_bar_mousewheel(e, tab_bar_state["canvas"]))
        widget.bind("<Button-4>", lambda e: on_tab_bar_mousewheel(e, tab_bar_state["canvas"]))
        widget.bind("<Button-5>", lambda e: on_tab_bar_mousewheel(e, tab_bar_state["canvas"]))

    tabs_dict[node_key] = {
        "page": page_frame,
        "tab_root": tab_root,
        "body": tab_body,
        "lbl_title": lbl_title,
        "btn_close": btn_close,
        "bottom_gap": bottom_gap
    }

    tab_bar_state["canvas"].update_idletasks()
    tab_bar_state["canvas"].configure(scrollregion=tab_bar_state["canvas"].bbox("all"))
				
    select_workspace_tab(node_key, tab_bar_state)


# Sidebar & Synchronization ---------------------------------------------------
def sync_sidebar_selection(treeview_widget: ttk.Treeview, active_key: str) -> None:
    """
	Highlights the corresponding node in the sidebar.
	"""
    for parent_id in treeview_widget.get_children():
        for child_id in treeview_widget.get_children(parent_id):
            vals = treeview_widget.item(child_id, "values")

            if vals and vals[0] == active_key:
                if treeview_widget.focus() != child_id:
                    treeview_widget.item(parent_id, open=True)
                    treeview_widget.selection_set(child_id)
                    treeview_widget.focus(child_id)

                return


