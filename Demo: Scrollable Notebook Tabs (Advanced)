def register_tab(
    manager: dict,
    node_key: str,
    page: tk.Frame,
    tab_widgets: dict,
) -> None:
    """
    Adds a completed tab to the application's tab registry.
    """
    manager["tabs"][node_key] = {
        "page": page,
        **tab_widgets,
    }

