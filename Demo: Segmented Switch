"""
Demo: Segmented Switch
Description:
A procedural, anti-aliased segmented switch for selecting among N options.
Features a sliding pill indicator, hover states, and smooth ease-out animations.
"""

import tkinter as tk
import tkinter.font as tkfont
from typing import Callable, List, Optional
from PIL import Image, ImageDraw, ImageTk


# RENDERING PIPELINE ----------------------------------------------------------
def render_segmented_surface(state: dict) -> None:
    """
    Renders the outer pill container and the sliding selection pill via Pillow,
    then projects downsampled anti-aliased graphics onto the base canvas.
    """
    canvas: tk.Canvas = state["canvas"]
    parent_bg = canvas.cget("bg")

    # High-resolution buffer
    img = Image.new("RGBA", (state["sw"], state["sh"]), parent_bg)
    draw = ImageDraw.Draw(img)

    # 1. Outer track background
    draw.rounded_rectangle(
        [0, 0, state["sw"] - 1, state["sh"] - 1],
        radius=state["s_radius"],
        fill=state["bg_track"],
    )

    # 2. Sliding indicator pill
    ix0 = state["indicator_x"]
    ix1 = ix0 + state["indicator_w"]
    iy0 = state["s_pad"]
    iy1 = state["sh"] - state["s_pad"]
    pill_radius = (iy1 - iy0) // 2

    draw.rounded_rectangle(
        [ix0, iy0, ix1 - 1, iy1 - 1],
        radius=pill_radius,
        fill=state["bg_indicator"],
    )

    # 3. Downscale using Lanczos filter
    smooth_img = img.resize((state["w"], state["h"]), Image.Resampling.LANCZOS)
    state["img_ref"] = ImageTk.PhotoImage(smooth_img)
    canvas.itemconfig(state["canvas_img_id"], image=state["img_ref"])


# ANIMATION & INTERACTION -----------------------------------------------------
def animate_indicator(
    target_x: float,
    target_w: float,
    state: dict,
    step: int = 0,
    total_steps: int = 8
) -> None:
    """
    Animates both indicator position and width using exponential decay.
    """
    canvas: tk.Canvas = state["canvas"]

    if step >= total_steps:
        state["indicator_x"] = target_x
        state["indicator_w"] = target_w
        render_segmented_surface(state)
        state["animating"] = False
        return

    # Frame easing step (40% approach per frame)
    state["indicator_x"] += (target_x - state["indicator_x"]) * 0.4
    state["indicator_w"] += (target_w - state["indicator_w"]) * 0.4
    render_segmented_surface(state)

    canvas.after(16, lambda: animate_indicator(target_x, target_w, state, step + 1, total_steps))


def select_segment_index(index: int, state: dict) -> None:
    """
    Activates segment at index, repositioning the indicator and firing callbacks.
    """
    if index < 0 or index >= len(state["segments"]):
        return

    state["selected_index"] = index
    state["animating"] = True

    # Target virtual coordinates
    target_x = state["seg_bounds"][index]["x"]
    target_w = state["seg_bounds"][index]["w"]

    # Reposition indicator
    animate_indicator(target_x, target_w, state)

    # Update text label colors (active vs inactive)
    canvas: tk.Canvas = state["canvas"]

    for i, seg in enumerate(state["segments"]):
        color = state["fg_active"] if i == index else state["fg_inactive"]
        canvas.itemconfig(seg["canvas_text_id"], fill=color)

    if state["command"]:
        state["command"](state["segments"][index]["label"], index)


# WIDGET FUNCTIONS ------------------------------------------------------------
def create_segmented_control(
    parent: tk.Misc,
    options: List[str],
    font: tuple = ("Segoe UI", 10, "bold"),
    height: int = 34,
    pad_h: int = 16,
    bg_track: str = "#2B2B2B",
    bg_indicator: str = "#0078D4",
    fg_active: str = "#FFFFFF",
    fg_inactive: str = "#AAAAAA",
    initial_index: int = 0,
    scale: int = 4,
    command: Optional[Callable[[str, int], None]] = None,
    **kwargs):
    """
    Constructs a responsive segmented selector.
    """
    f = tkfont.Font(font=font)
    text_widths = [f.measure(opt) for opt in options]

    # Calculate segment widths with balanced horizontal padding
    seg_widths = [w + (pad_h * 2) for w in text_widths]
    total_w = sum(seg_widths) + 6

    canvas = tk.Canvas(
        parent,
        width=total_w,
        height=height,
        highlightthickness=0,
        borderwidth=0,
        cursor="hand2",
        **kwargs,
    )

    # Draw text items above the indicator image
    for i, seg in enumerate(segments):
        color = fg_active if i == initial_index else fg_inactive
        text_id = canvas.create_text(
            seg["center_x"],
            height // 2,
            text=seg["label"],
            font=font,
            fill=color,
            anchor="center",
        )
        seg["canvas_text_id"] = text_id

    return canvas


# LAUNCH APPLICATION ----------------------------------------------------------
def create_demo_application() -> None:
    root = tk.Tk()
    root.title("Demo: Segmented Switch")
    root.geometry("480x260")
    root.configure(bg="#1E1E1E")

    lbl_choice = tk.Label(
        root,
        text="View Mode: Daily",
        font=("Segoe UI", 11),
        bg="#1E1E1E",
        fg="#FFFFFF",
    )
    lbl_choice.pack(pady=(40, 20))

    # Helper Function for create_segmented_control
    def on_select(label: str, index: int) -> None:
        lbl_choice.configure(text=f"View Mode: {label} (Index: {index})")

    control, _ = create_segmented_control(
        root,
        options=["Daily", "Weekly", "Monthly", "Annual"],
        bg_track="#2D2D30",
        bg_indicator="#0078D4",
        fg_active="#FFFFFF",
        fg_inactive="#8E8E93",
        command=on_select,
    )
    control.pack()

    root.mainloop()


# LAUNCH APPLICATION ----------------------------------------------------------
if __name__ == "__main__":
    create_demo_application()

