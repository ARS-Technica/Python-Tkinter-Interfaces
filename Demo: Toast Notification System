def build_buttons(parent: tk.Misc, toast_mgr: dict) -> list[tk.Button]:
    """
    Constructs and packs the full suite of demo trigger buttons for the toast system.
    Returns a list of the instantiated button widgets.
    """
    global button_specs

    buttons = []

    for spec in BUTTON_SPECS:
        btn = create_button(
            parent,
            text=spec["text"],
            bg_color=spec["bg"],
            command=lambda s=spec: show_toast(
                toast_mgr,
                title=s["title"],
                message=s["message"],
                toast_type=s["type"],
            ),
        )
        buttons.append(btn)

    return buttons


def create_button(
    parent: tk.Misc,
    text: str,
    bg_color: str,
    command: Callable[[], None],
    fg_color: str = "#FFFFFF",
    font: tuple = ("Segoe UI", 9, "bold"),
    padx: int = 14,
    pady: int = 6,
    pack_side: Optional[str] = "left",
    pack_padx: int = 6,
    pack_pady: int = 0,
) -> tk.Button:
    """
    Function that builds and styles a flat, modern button.
    Optionally packs the widget into the parent container if pack_side is provided.
    """
    btn = tk.Button(
        parent,
        text=text,
        bg=bg_color,
        fg=fg_color,
        font=font,
        relief="flat",
        activebackground=bg_color,
        activeforeground=fg_color,
        padx=padx,
        pady=pady,
        cursor="hand2",
        command=command,
    )

    if pack_side:
        btn.pack(side=pack_side, padx=pack_padx, pady=pack_pady)

    return btn


# RENDERING PIPELINE ----------------------------------------------------------
def render_toast(toast: dict) -> None:
    """
    Renders an anti-aliased rounded card with an accent status indicator
    into an in-memory Pillow buffer, scales down with Lanczos, and updates the canvas.
    """
    canvas: tk.Canvas = toast["canvas"]
    parent_bg = canvas.cget("bg")
    sw, sh = toast["sw"], toast["sh"]
    scale = toast["scale"]

    img = Image.new("RGBA", (sw, sh), parent_bg)
    draw = ImageDraw.Draw(img)

    corner_radius = 8 * scale
    draw.rounded_rectangle(
        [0, 0, sw - 1, sh - 1],
        radius=corner_radius,
        fill=toast["theme"]["bg"],
    )

    bar_w = 4 * scale
    draw.rounded_rectangle(
        [0, 0, bar_w, sh - 1],
        radius=corner_radius,
        fill=toast["theme"]["accent"],
    )

    smooth_img = img.resize((toast["w"], toast["h"]), Image.Resampling.LANCZOS)
    toast["img_ref"] = ImageTk.PhotoImage(smooth_img)
    canvas.itemconfig(toast["canvas_img_id"], image=toast["img_ref"])


# ANIMATION & STACK MANAGEMENT ------------------------------------------------
def animate_toast_slide(toast: dict, manager_state: dict) -> None:
    """
    Step for entering and exiting toasts.
    """
    canvas: tk.Canvas = toast["canvas"]

    if not canvas.winfo_exists():
        return

    target = toast["target_y_offset"]
    curr = toast["current_y_offset"]
    new_y = curr + (target - curr) * 0.35

    if abs(target - new_y) < 1.0:
        new_y = target
        toast["current_y_offset"] = new_y

    else:
        toast["current_y_offset"] = new_y


def dismiss_toast:
    """
    Initiates smooth slide-out and cleanup for a toast.
    """
    if toast:
        return


