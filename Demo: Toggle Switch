"""
Demo: Toggle Switch
Created: October 22, 2026

Description:
A standalone, anti-aliased animated pill toggle switch for Tkinter.
Standard Tkinter Canvas drawing produces aliased (pixelated/jagged) curves.
This component solves that by rendering the pill track and thumb at 4x scale
in Pillow (PIL) and downsampling to physical dimensions using a Lanczos filter.
It also features 60fps non-blocking animation and dark/light mode background syncing.
"""

import tkinter as tk
from typing import Callable, Optional
from PIL import Image, ImageDraw, ImageTk


class AntiAliasedToggle(tk.Canvas):
    """
    Anti-aliased animated toggle switch using supersampled Pillow rendering.

    Inherits from tk.Canvas to act as a lightweight container displaying a
    single updating ImageTk.PhotoImage bitmap.
    """
    def __init__(
        self,
        parent: tk.Misc,
        width: int = 56,
        height: int = 28,
        bg_off: str = "#CCCCCC",
        bg_on: str = "#0078D4",
        thumb_color: str = "#FFFFFF",
        initial_state: bool = False,
        scale: int = 4,  # 4x supersampling for smooth edges
        command: Optional[Callable[[bool], None]] = None,
        **kwargs
    ):
        # Auto-detect parent's background color so the rectangular canvas frame
        # seamlessly blends into its container without hardcoded colors.
        if "bg" not in kwargs and "background" not in kwargs:
            try:
                parent_bg = parent.cget("bg")
            except Exception:
                parent_bg = "#F8F9FA"
            kwargs["bg"] = parent_bg

        # Initialize the underlying tk.Canvas with zero borders to prevent border clipping
        super().__init__(
            parent,
            width=width,
            height=height,
            highlightthickness=0,
            borderwidth=0,
            cursor="hand2",
            **kwargs
        )
        # Base configuration and dimensions
        self.w = width
        self.h = height
        self.scale = scale
        self.bg_off = bg_off
        self.bg_on = bg_on
        self.thumb_color = thumb_color
        self.command = command

        # State flags
        self._is_on = initial_state
        self._animating = False

    def get(self) -> bool:
        """
        Returns True if toggled ON, False if OFF.
        """
        return self._is_on
    
    
    def set(self, value: bool) -> None:
        """
        Programmatically flips the switch with standard animation.
        """
        if self._is_on != value:
            self._on_click()



